{
  "name": "typespeed",
  "version": "1.0.0",
  "private": true,
  "description": "Browser typing trainer. Plain HTML/CSS/JS, no build step.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"*.{js,css,html,json,md}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"*.{js,css,html,json,md}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
