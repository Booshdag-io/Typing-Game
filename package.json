{
  "name": "typespeed",
  "version": "1.0.0",
  "private": true,
  "description": "Browser typing trainer. Plain HTML/CSS/JS, no build step.",
  "scripts": {
    "lint": "eslint script.js",
    "lint:fix": "eslint --fix script.js",
    "format": "prettier --write \"*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"*.{js,css,html,json,md}\"",
    "check": "npm run lint && npm run format:check"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
